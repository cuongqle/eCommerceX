{
  "name": "ecommercex-backend",
  "version": "1.0.0",
  "description": "eCommerceX API — storefront and admin dashboard",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:dist": "node dist/scripts/seed.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:dist": "node dist/scripts/migrate.js",
    "migrate:status": "migrate-mongo status",
    "migrate:create": "migrate-mongo create",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docker": "docker compose -f ../docker-compose.yml run --rm api-test",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../docker-compose.yml up -d db",
    "compose:up": "docker compose --env-file ../backend/.env -f ../docker-compose.yml up -d --build",
    "compose:down": "docker compose -f ../docker-compose.yml down"
  },
  "keywords": [
    "ecommerce",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.9.5",
    "morgan": "^1.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/migrate-mongo": "^14.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
