NODE_ENV=development
PORT=4000
# Local `npm run dev`: Mongo on the host (compose service `db` publishes 27017)
# Docker API service overrides this to mongodb://db:27017/ecommercex
MONGODB_URI=mongodb://127.0.0.1:27017/ecommercex
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Product image uploads — from the Cloudinary dashboard (API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommercex/products
# First API boot seeds demo catalog when the database has no users
SEED_ON_EMPTY=true
